{
  "name": "@barbertime/dominio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "dominio",
    "tags": [
      "type:dominio",
      "scope:shared"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "libs/dominio"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {}
}
