{
  "name": "@barbertime/ui-vuetify",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "ui-vuetify",
    "tags": [
      "type:ui",
      "scope:front"
    ],
    "targets": {
      "typecheck": {
        "command": "vue-tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "libs/ui-vuetify"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "devDependencies": {
    "@barbertime/ui-contrato": "workspace:*"
  },
  "dependencies": {
    "@barbertime/ui-tokens": "workspace:*",
    "@barbertime/ui-utils": "workspace:*",
    "@mdi/js": "7.4.47",
    "qrcode": "1.5.4",
    "vuetify": "4.3.0"
  }
}
