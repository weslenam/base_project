{
  "name": "@barbertime/ui-contrato",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "ui-contrato",
    "tags": [
      "type:ui",
      "scope:front"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "libs/ui-contrato"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {}
}
