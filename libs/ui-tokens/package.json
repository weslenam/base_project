{
  "name": "@barbertime/ui-tokens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "ui-tokens",
    "tags": [
      "type:ui",
      "scope:front"
    ],
    "targets": {
      "gerar": {
        "command": "node scripts/gerar-tokens.ts",
        "options": {
          "cwd": "libs/ui-tokens"
        },
        "inputs": [
          "{workspaceRoot}/docs/identidade-visual/tokens.json",
          "{projectRoot}/scripts/**/*"
        ],
        "outputs": [
          "{projectRoot}/src/tokens.css",
          "{projectRoot}/src/tokens.ts"
        ]
      },
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "libs/ui-tokens"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/big-shoulders": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
