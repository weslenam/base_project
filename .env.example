# Copie para .env (cp .env.example .env) e ajuste. O .env não é versionado.
# Valores abaixo são só para desenvolvimento local.

# PostgreSQL
POSTGRES_DB=barbertime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me-postgres
POSTGRES_PORT=5432
# Senha do papel barbertime_app (sem superusuário, sujeito a RLS)
APP_DB_PASSWORD=troque-me-app

# Redis
REDIS_PORT=6379

# Mailpit (captura de e-mails): web em http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# API rodando fora do Docker (pnpm dev) usa o banco exposto no host
# Supabase local (ADR 0015): pnpm supabase start. Studio em http://127.0.0.1:54323,
# e-mails capturados em http://127.0.0.1:54324. A senha "postgres" é a padrão do
# Supabase local (só desenvolvimento). A senha do barbertime_app é aplicada ao papel
# por pnpm nx run api:migrar (ou pelos testes de integração).
DATABASE_URL=postgres://barbertime_app:troque-me-app@127.0.0.1:54322/postgres
DATABASE_URL_MIGRACAO=postgres://postgres:postgres@127.0.0.1:54322/postgres
SMTP_URL=smtp://127.0.0.1:54325
# Volta atrás para o Postgres e o Mailpit do docker-compose (até a sprint S8):
# DATABASE_URL=postgres://barbertime_app:troque-me-app@localhost:5432/barbertime
# DATABASE_URL_MIGRACAO=postgres://postgres:troque-me-postgres@localhost:5432/barbertime
# SMTP_URL=smtp://localhost:1025
REDIS_URL=redis://localhost:6379
# Links enviados por e-mail (recuperação de senha) apontam para cá
APP_URL=http://localhost:4200
# Atrás de proxy (nginx, balanceador) em produção: true (ADR 0014)
TRUST_PROXY=false

# Página pública de agendamento (planejamento 0019): bloqueada até a análise de
# segurança. Use "liberada" para abrir em desenvolvimento.
PAGINA_PUBLICA=bloqueada
