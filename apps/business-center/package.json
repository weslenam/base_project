{
  "name": "@barbertime/business-center",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "business-center",
    "tags": [
      "type:app",
      "scope:front"
    ],
    "targets": {
      "typecheck": {
        "command": "vue-tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "apps/business-center"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  },
  "type": "module",
  "dependencies": {
    "@barbertime/ui-tokens": "workspace:*",
    "@barbertime/ui-utils": "workspace:*",
    "@barbertime/ui-vuetify": "workspace:*",
    "@barbertime/dominio": "workspace:*"
  }
}
