{
  "name": "@barbertime/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "serve": {
        "continuous": true,
        "command": "node --watch src/main.js",
        "options": {
          "cwd": "apps/api"
        }
      },
      "migrar": {
        "command": "node scripts/migrar.js",
        "options": {
          "cwd": "apps/api"
        }
      },
      "semear": {
        "command": "node scripts/semear.js",
        "options": {
          "cwd": "apps/api"
        }
      },
      "operador": {
        "command": "node scripts/operador.js",
        "options": {
          "cwd": "apps/api"
        }
      },
      "integracao": {
        "command": "vitest run -c vitest.integracao.config.js",
        "options": {
          "cwd": "apps/api"
        }
      },
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "apps/api"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    },
    "tags": [
      "type:app",
      "scope:back"
    ]
  },
  "dependencies": {
    "@barbertime/dominio": "workspace:*",
    "@fastify/autoload": "~6.5.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "~6.0.6",
    "fastify": "~5.12.5",
    "fastify-plugin": "~6.0.0",
    "kysely": "^0.29.8",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1"
  },
  "type": "module",
  "scripts": {
    "start": "node src/main.js"
  }
}
